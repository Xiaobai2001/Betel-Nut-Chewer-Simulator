}.breath-overlay{position:fixed;inset:0;z-index:30;padding:140rpx 50rpx;background:#f7f9f2;display:flex;flex-direction:column;align-items:center;justify-content:center}.breath-circle{width:400rpx;height:400rpx;background:#e8efdc;border:2rpx solid #c6d6b0;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:60rpx 0;font-size:40rpx;color:#68844e}.breath-circle text{font:66rpx Georgia,serif;margin-top:25rpx}.breath-overlay .footnote{text-align:center}.immersive{position:fixed;inset:0;background:#f7f8f4;z-index:20;padding-left:20rpx;padding-right:20rpx;overflow-y:auto}.immersive .brand-row{height:60rpx;margin-bottom:8rpx}.immersive .brand-icon{height:46rpx;width:46rpx}.immersive .brand-sub{display:none}.immersive .scene-toolbar{margin:3rpx 0 8rpx}.immersive .stage{border-radius:18rpx}.immersive .control-card{padding:14rpx 16rpx 0}.immersive .control-heading,.immersive .control-caption,.immersive .wear-track,.immersive .auto-button{display:none}.immersive .controls button{padding:12rpx 0;font-size:23rpx}.immersive .light-button{margin-top:0}.immersive .action-row{margin:10rpx 0}.immersive .scene-tools{padding:10rpx 0}.immersive .pack-card{padding-top:12rpx}.immersive .pack-options{margin-bottom:0}.immersive .pack-option{padding:5rpx}.immersive .tier-number{font-size:27rpx}.immersive .tier-label{font-size:17rpx}.immersive .rest-button{padding:12rpx 20rpx;margin-top:12rpx;font-size:23rpx}.immersive .health-note{margin:10rpx 0;font-size:18rpx}
