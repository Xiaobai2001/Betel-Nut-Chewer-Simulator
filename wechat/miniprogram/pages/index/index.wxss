page{min-height:100%}
.immersive{position:fixed;left:0;top:0;z-index:30}
.experience{display:flex;flex-direction:column;box-sizing:border-box;max-width:100%;padding:8px 10px;gap:8px;overflow-x:hidden;overflow-y:auto;background:#f7f8f4}
.experience>view{flex-shrink:0;min-width:0}.experience button{box-sizing:border-box;width:auto!important;min-width:0!important;max-width:100%;margin:0;line-height:1.35;font-size:13px;padding:0 8px;white-space:nowrap;border-radius:8px}
.scene-toolbar{display:flex;align-items:center;justify-content:space-between;height:32px;gap:8px}.account-pill{font-size:10px;white-space:nowrap;flex:0 0 auto;max-width:40%;overflow:hidden;text-overflow:ellipsis;padding:4px 8px}.toolbar-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:0;flex:1}.toolbar-actions .mini-button{height:30px;padding:0 11px;font-size:11px;background:#fafcf7;border:1px solid #dfe6d4;flex:0 1 auto}
.experience .lab{display:flex;flex-direction:column;flex:1 1 0;min-height:180px;background:#fff;border:1px solid #e0e6d5;border-radius:13px;overflow:hidden}.lab-heading{height:33px;padding:0 11px;display:flex;align-items:center;justify-content:space-between;font-size:12px;flex-shrink:0;border-bottom:1px solid #e8ecdf}.section-number{font:8px Georgia,serif;color:#a3ad91;margin-right:9px}.lab-hint{font-size:9px;color:#9ca78f;white-space:nowrap}
.stage{position:relative;flex:1;min-height:0;width:100%;overflow:hidden;background:#f4f6ee}.scene-canvas{display:block;position:absolute;left:0;top:0;width:100%;height:100%}.stage-status{position:absolute;top:12px;left:12px;color:#829170;font-size:10px;pointer-events:none}.stage-status>text{font-size:8px;color:#a4ae99}.stage-status>view{margin-top:4px;max-width:190px}.stage-metrics{position:absolute;top:10px;right:12px;text-align:right;pointer-events:none}.stage-metrics .metric-value{font:26px Georgia,serif}.stage-metrics .metric-unit{font-size:9px;margin-left:4px}.stage-wear{font-size:9px;color:#91a17d}.stage-help{position:absolute;bottom:7px;left:0;right:0;text-align:center;font-size:9px;color:#94a181;pointer-events:none}
.scene-tools{display:flex;align-items:center;gap:7px;height:30px}.scene-tools>button{height:28px;font-size:10px;padding:0 9px;background:#fff;border:1px solid #dce5d0;flex:none}.scene-tools slider{flex:1;min-width:0;width:0;margin:0 8px}
.controls{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;width:100%}.control-card{display:flex;flex-direction:column;min-width:0;padding:9px 8px 3px;background:#fff;border:1px solid #e0e7d6;border-radius:11px;overflow:hidden}.control-heading{display:flex;align-items:center;justify-content:space-between;gap:5px;font-size:9px;color:#8d9b7b;height:15px}.control-heading text{white-space:nowrap}.control-info{height:34px;display:flex;flex-direction:column;justify-content:center;font-size:9px;color:#91a080;min-width:0}.wear-track{height:3px;background:#e7eddd;margin-top:7px;border-radius:4px;overflow:hidden}.wear-track view{height:100%;background:#91a971}.smoke-info{position:relative}.smoke-canvas{display:block;position:absolute;left:0;top:0;width:100%;height:100%}.control-card>button.primary,.control-card>button.light-button{width:100%!important;height:38px;font-size:14px}.light-button{background:#fbf6e9;border:1px solid #e7dbba;color:#9e8551}.controls .action-row{display:flex;gap:5px;margin-top:6px}.controls .action-row>button{flex:1;width:0!important;height:32px;font-size:12px;padding:0 2px}.control-card>.auto-button{width:100%!important;height:27px;font-size:10px;color:#81966a;background:transparent}
.pack-card{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #e0e6d5;border-radius:10px;padding:5px 7px;height:54px}.pack-heading{display:flex;flex-direction:column;gap:3px;flex:0 0 29px;font-size:10px;color:#80936a}.pack-heading text:last-child{font-size:9px;color:#9ba58d}.pack-options{flex:1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;min-width:0}.pack-options .pack-option{width:100%!important;min-width:0;display:flex;align-items:center;justify-content:center;gap:5px;padding:3px;height:42px;border:1px solid #e3e8d9;background:#fafcf7}.pack-option.selected{background:#eef4e5;border-color:#a4ba87}.mini-bag{height:31px;width:22px;flex:none;background:linear-gradient(110deg,#5c7150,#7f8d61 48%,#566c43);border-top:3px solid #8e9c72;border-radius:1px 1px 4px 4px;color:#f3edcd;font:12px Georgia,serif;display:flex;align-items:center;justify-content:center;transform:rotate(-4deg)}.tier-100 .mini-bag{background:linear-gradient(110deg,#ac915e,#c2ae7d,#a48c58);border-color:#cfc08f;transform:rotate(3deg)}.tier-200 .mini-bag{background:linear-gradient(110deg,#414a45,#5d6359,#384139);border-color:#8a9382;transform:rotate(-3deg)}.tier-label{font-size:9px;color:#7e8f68}.tier-count{font-size:8px;color:#a3ad96;margin-top:2px}
.bottom-row{display:flex;align-items:center;justify-content:space-between;gap:6px;min-height:28px}.health-note{font-size:8px;color:#96a184;line-height:1.7;flex:1;min-width:0}.bottom-row .rest-button{font-size:10px;color:#718b54;background:#edf3e4;padding:0 7px;height:28px;flex:none}.error-toast{position:fixed;bottom:30%;left:20px;right:20px;padding:14px;background:#566844f5;color:#fff;border-radius:10px;font-size:12px;line-height:1.8;z-index:40}.immersive .stage{background:#f7f8f4}
.compact{gap:5px;padding-top:5px}.compact .scene-toolbar{height:29px}.compact .lab{min-height:137px}.compact .lab-heading{height:27px;font-size:11px}.compact .control-card{padding:5px 7px 1px}.compact .control-info{height:23px;font-size:8px}.compact .control-card>button.primary,.compact .control-card>button.light-button{height:32px;font-size:13px}.compact .controls .action-row>button{height:28px;font-size:11px}.compact .control-card>.auto-button{height:23px;font-size:9px}.compact .pack-card{height:47px}.compact .pack-option{height:36px}.compact .mini-bag{height:27px}.compact .bottom-row{min-height:24px}.compact .rest-button{height:24px}.compact .scene-tools{height:26px}.compact .stage-status{top:9px}.compact .stage-status>view{max-width:175px}
.pack-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:5}.opening-bag{position:relative;width:110px;height:150px;border:1px solid #9aaa7b;border-radius:4px 4px 12px 12px;background:#e5edda;color:#708955;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:6px 10px 18px #53603725;animation:bag-in 1.3s both}.opening-bag.tier-100{background:#eee4c6;color:#9b844f}.opening-bag.tier-200{background:#5c6d4d;color:#f0f2e6}.opening-name{font-size:14px;letter-spacing:4px}.opening-price{font:36px Georgia,serif}.opening-caption{font-size:9px}.tear{position:absolute;top:-7px;left:-1px;right:-1px;height:16px;border:1px solid #9aaa7b;background:#dce6c8;animation:tear 1.3s both;transform-origin:right center}.reduced .opening-bag,.reduced .tear{animation:none}.reduced .tear{display:none}@keyframes bag-in{0%{opacity:0;transform:translateY(10px) rotate(-10deg) scale(.8)}20%,75%{opacity:1;transform:rotate(-4deg)}100%{opacity:0;transform:translateY(15px) scale(.8)}}@keyframes tear{0%,25%{transform:none}60%,100%{opacity:0;transform:translate(33px,-45px) rotate(35deg)}}
.breath-overlay{position:fixed;inset:0;z-index:30;padding:30px 24px;background:#f7f9f2;display:flex;flex-direction:column;align-items:center;justify-content:center}.breath-circle{width:200px;height:200px;background:#e8efdc;border:1px solid #c6d6b0;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:30px 0;font-size:20px;color:#68844e}.breath-circle text{font:33px Georgia,serif;margin-top:12px}.breath-overlay .footnote{text-align:center;font-size:11px}.breath-overlay>button{width:auto!important;padding:12px 25px}

/* The normal page follows the website's scrolling phone layout. */
.web-home button{box-sizing:border-box;margin:0;min-width:0;white-space:nowrap}
.web-enter{font-size:10px;line-height:1.4;padding:9px 10px;border-radius:8px;color:#63754e;background:#eaf0df;border:1px solid #dce5ce}
.web-stage{position:relative;height:264px;margin:0 12px;overflow:hidden;background:#f3f5ed;border:1px solid #edf0e5;border-radius:12px}.web-stage-grid{position:absolute;inset:0;opacity:.5;background-image:radial-gradient(#cfd8c3 .7px,transparent .7px);background-size:19px 19px}.web-stage:after{content:"";position:absolute;pointer-events:none;width:230px;height:230px;left:50%;top:49%;transform:translate(-50%,-50%);border:1px solid #dce4d2;border-radius:50%}.web-main-canvas{position:absolute;left:0;top:0;width:100%;height:100%;z-index:1}.web-stage-status{position:absolute;left:14px;top:16px;z-index:2;pointer-events:none}.web-stage-status>text{font-size:9px;color:#9ca58e}.web-stage-status>view{font-size:10px;color:#65744e;margin-top:6px;max-width:200px}.web-stage-counter{position:absolute;right:14px;top:15px;text-align:right;z-index:2;pointer-events:none}.web-stage-counter>view{font:29px Georgia,serif;color:#61714e}.web-stage-counter>text{font-size:8px;color:#9ea58f}.web-stage-caption{position:absolute;bottom:38px;left:0;right:0;text-align:center;font-size:9px;color:#899775;z-index:2;pointer-events:none}.web-pulse-dot{display:inline-block;width:4px;height:4px;background:#9eaf85;border-radius:50%;vertical-align:2px;margin-right:7px}.web-stage-bottom{position:absolute;bottom:14px;left:13px;right:13px;display:flex;justify-content:space-between;font-size:7px;color:#a6ae9a;z-index:2;pointer-events:none}
.web-texture{padding:17px 18px 0}.web-texture-top{display:flex;align-items:center;justify-content:space-between;font-size:11px}.web-texture-top>view:first-child{display:flex;align-items:center;gap:10px}.web-texture-top>view:first-child text{font-size:9px;color:#9a9f92;background:#f3f5ee;padding:3px 6px;border-radius:4px}.web-wear-value{font-size:15px;color:#6a7b52}.web-wear-value text{font-size:9px;color:#9a9f92;margin-left:3px}.web-progress-track{height:6px;background:#edf1e6;border-radius:9px;overflow:hidden;margin:10px 0}.web-progress-track>view{height:100%;border-radius:9px;background:linear-gradient(90deg,#a3b880,#637d46);transition:width .25s}.web-texture-scale{display:flex;justify-content:space-between;font-size:8px;color:#acb1a2}
.web-chew-controls{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,.9fr) minmax(0,1.2fr);padding:20px 16px 0;gap:7px}.web-chew-controls>button{width:100%!important;min-width:0}.web-control-footer{display:flex;align-items:center;justify-content:space-between;padding:16px 18px 19px;font-size:9px;color:#a1a895}.web-control-footer .web-auto{padding:0;background:transparent;display:flex;align-items:center;gap:8px;font-size:10px;color:#8f9981;line-height:1.5}.web-toggle{width:27px;height:15px;border-radius:14px;background:#dce2d3;position:relative}.web-toggle>view{width:11px;height:11px;position:absolute;left:2px;top:2px;border-radius:50%;background:#fff;transition:transform .2s}.web-toggle.on{background:#6a8150}.web-toggle.on>view{transform:translateX(12px)}
.web-session{padding:18px 15px;margin-top:14px;display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;align-items:center}.web-session-title{display:flex;gap:7px;align-items:center;font-size:10px}.web-session-title image{width:16px;height:16px}.web-session-title text{display:block;font-size:7px;color:#aab09f;margin-top:5px}.web-session>view:not(:first-child){display:flex;flex-direction:column;align-items:center;gap:5px;border-left:1px solid #eef0e8;font-size:8px;color:#929d86}.web-session-value{font:23px Georgia,serif;color:#6e8058}
.web-pack-panel,.web-smoke-panel{margin-top:17px;position:relative}.web-pack-panel>.web-description{padding:0 18px}.web-pack-options{display:flex;gap:13px;padding:17px 19px}.web-pack-options .web-pack-option{position:relative;flex:1;width:0!important;min-width:0;display:flex;align-items:center;flex-direction:column;background:#fff;border:1px solid #eaede5;border-radius:11px;padding:14px 4px 13px;line-height:1.5}.web-pack-option.selected{background:#f5f8ef;border-color:#a9ba8c;box-shadow:0 0 0 1px #a9ba8c22}.web-pack-art{width:70px;height:99px;border-radius:3px 3px 6px 6px;background:linear-gradient(110deg,#5c7150,#7f8d61 48%,#566c43);color:#e3e6c7;box-shadow:4px 6px 6px #2338131a,inset 2px 0 3px #ffffff40;transform:rotate(-5deg);display:flex;align-items:center;flex-direction:column;position:relative;overflow:hidden;border:1px solid #677950}.web-pack-art:after{content:"";position:absolute;bottom:6px;left:6px;right:6px;height:1px;background:#ffffff40}.web-tier-100{background:linear-gradient(110deg,#ac915e,#c2ae7d 48%,#a48c58);color:#fff4d7;border-color:#b59b67;transform:rotate(3deg)}.web-tier-200{background:linear-gradient(110deg,#414a45,#5d6359 48%,#384139);color:#d2c9a4;border-color:#545b50;transform:rotate(-3deg)}.web-pack-seal{height:7px;width:100%;background:repeating-linear-gradient(90deg,transparent 0 2px,#0002 2px 3px);border-bottom:1px solid #fff2}.web-pack-brand{font-size:12px;letter-spacing:2px;margin-top:8px}.web-pack-leaf{position:absolute;right:3px;top:20px;font-size:27px;opacity:.2;transform:rotate(-40deg)}.web-pack-number{font:25px Georgia,serif;margin-top:7px}.web-pack-detail{font:4px sans-serif;letter-spacing:1px;margin-top:5px}.web-pack-price{font:20px Georgia,serif;color:#64754c;margin-top:13px}.web-pack-name{font-size:9px;color:#a5ad9a;margin-top:4px}.web-pack-selected{position:absolute;right:4px;top:4px;width:14px;height:14px;border-radius:50%;background:#819561;color:#fff;font-size:9px;text-align:center}.web-pack-stock{margin:0 22px;display:flex;align-items:center;justify-content:space-between;background:#f8f9f5;border-radius:7px;padding:12px;font-size:10px;color:#929c83;gap:5px}.web-pack-stock button{padding:0;background:none;font-size:10px;color:#7c8b67}.web-tiny-note{font-size:8px;color:#a6ad9b;line-height:1.8;text-align:center;margin:13px 15px 17px}
.web-smoke-panel .web-card-heading{padding-bottom:0}.web-smoke-visual{height:116px;position:relative;margin:0 23px}.web-smoke-visual canvas{width:100%;height:100%}.web-smoke-visual>text{position:absolute;right:2px;bottom:18px;font-size:8px;color:#a5ab9c;pointer-events:none}.web-smoke-controls{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) minmax(0,1fr);padding:0 20px;gap:10px}.web-smoke-controls button{width:100%!important;height:41px;min-height:41px;font-size:11px}.web-smoke-footer{padding:15px 22px;display:flex;align-items:center;justify-content:space-between;font-size:9px;color:#a0a793;gap:5px}.web-smoke-footer button{min-width:36px!important;min-height:28px;padding:2px;background:none;font-size:9px;color:#8b967c}.web-smoke-warning{padding:13px;background:#faf8f2;border-top:1px solid #f1ecdf;display:flex;align-items:center;justify-content:center;gap:6px;color:#b1a488;font-size:9px}.web-smoke-warning image{width:12px;height:12px}.web-box-stock{display:flex;align-items:center;gap:12px;margin:3px 20px 0;padding:14px 0;border-top:1px solid #eef0e7;font-size:10px;color:#929d83}.web-box-stock>view:last-child{flex:1}.web-box-stock text{display:block;font-size:8px;line-height:1.8;margin-top:4px}.web-cigarette-box{width:30px;height:40px;background:#ded6c1;border:1px solid #c7c3ad;border-radius:2px;transform:rotate(-5deg);font:15px Georgia,serif;text-align:center;padding-top:13px;color:#918b76;position:relative;flex:none}.web-cigarette-box>view{position:absolute;top:-3px;left:-1px;right:-1px;height:9px;border:1px solid #c7c3ad;background:#eee9d9}
@media(max-width:350px){.web-pack-options{gap:8px;padding-left:13px;padding-right:13px}.web-pack-art{width:58px;height:88px}.web-pack-name{font-size:8px}.web-chew-controls{padding-left:12px;padding-right:12px;gap:5px}.web-chew-controls button{font-size:10px}.web-chew-controls image{width:13px;height:13px}.web-stage-status>view{max-width:160px}.web-smoke-controls{padding-left:15px;padding-right:15px;gap:6px}}
