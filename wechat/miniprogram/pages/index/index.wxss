page{height:100%;overflow:hidden}
.experience{display:flex;flex-direction:column;box-sizing:border-box;max-width:100%;padding:8px 10px;gap:8px;overflow-x:hidden;overflow-y:auto;background:#f7f8f4}
.experience>view{flex-shrink:0;min-width:0}.experience button{box-sizing:border-box;width:auto!important;min-width:0!important;max-width:100%;margin:0;line-height:1.35;font-size:13px;padding:0 8px;white-space:nowrap;border-radius:8px}
.scene-toolbar{display:flex;align-items:center;justify-content:space-between;height:32px;gap:8px}.account-pill{font-size:10px;white-space:nowrap;flex:0 0 auto;max-width:40%;overflow:hidden;text-overflow:ellipsis;padding:4px 8px}.toolbar-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:0;flex:1}.toolbar-actions .mini-button{height:30px;padding:0 11px;font-size:11px;background:#fafcf7;border:1px solid #dfe6d4;flex:0 1 auto}
.experience .lab{display:flex;flex-direction:column;flex:1 1 0;min-height:180px;background:#fff;border:1px solid #e0e6d5;border-radius:13px;overflow:hidden}.lab-heading{height:33px;padding:0 11px;display:flex;align-items:center;justify-content:space-between;font-size:12px;flex-shrink:0;border-bottom:1px solid #e8ecdf}.section-number{font:8px Georgia,serif;color:#a3ad91;margin-right:9px}.lab-hint{font-size:9px;color:#9ca78f;white-space:nowrap}
.stage{position:relative;flex:1;min-height:0;width:100%;overflow:hidden;background:#f4f6ee}.scene-canvas{display:block;position:absolute;left:0;top:0;width:100%;height:100%}.stage-status{position:absolute;top:12px;left:12px;color:#829170;font-size:10px;pointer-events:none}.stage-status>text{font-size:8px;color:#a4ae99}.stage-status>view{margin-top:4px;max-width:190px}.stage-metrics{position:absolute;top:10px;right:12px;text-align:right;pointer-events:none}.stage-metrics .metric-value{font:26px Georgia,serif}.stage-metrics .metric-unit{font-size:9px;margin-left:4px}.stage-wear{font-size:9px;color:#91a17d}.stage-help{position:absolute;bottom:7px;left:0;right:0;text-align:center;font-size:9px;color:#94a181;pointer-events:none}
.scene-tools{display:flex;align-items:center;gap:7px;height:30px}.scene-tools>button{height:28px;font-size:10px;padding:0 9px;background:#fff;border:1px solid #dce5d0;flex:none}.scene-tools slider{flex:1;min-width:0;width:0;margin:0 8px}
.controls{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;width:100%}.control-card{display:flex;flex-direction:column;min-width:0;padding:9px 8px 3px;background:#fff;border:1px solid #e0e7d6;border-radius:11px;overflow:hidden}.control-heading{display:flex;align-items:center;justify-content:space-between;gap:5px;font-size:9px;color:#8d9b7b;height:15px}.control-heading text{white-space:nowrap}.control-info{height:34px;display:flex;flex-direction:column;justify-content:center;font-size:9px;color:#91a080;min-width:0}.wear-track{height:3px;background:#e7eddd;margin-top:7px;border-radius:4px;overflow:hidden}.wear-track view{height:100%;background:#91a971}.smoke-info{position:relative}.smoke-canvas{display:block;position:absolute;left:0;top:0;width:100%;height:100%}.control-card>button.primary,.control-card>button.light-button{width:100%!important;height:38px;font-size:14px}.light-button{background:#fbf6e9;border:1px solid #e7dbba;color:#9e8551}.controls .action-row{display:flex;gap:5px;margin-top:6px}.controls .action-row>button{flex:1;width:0!important;height:32px;font-size:12px;padding:0 2px}.control-card>.auto-button{width:100%!important;height:27px;font-size:10px;color:#81966a;background:transparent}
.pack-card{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #e0e6d5;border-radius:10px;padding:5px 7px;height:54px}.pack-heading{display:flex;flex-direction:column;gap:3px;flex:0 0 29px;font-size:10px;color:#80936a}.pack-heading text:last-child{font-size:9px;color:#9ba58d}.pack-options{flex:1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;min-width:0}.pack-options .pack-option{width:100%!important;min-width:0;display:flex;align-items:center;justify-content:center;gap:5px;padding:3px;height:42px;border:1px solid #e3e8d9;background:#fafcf7}.pack-option.selected{background:#eef4e5;border-color:#a4ba87}.mini-bag{height:31px;width:22px;flex:none;background:linear-gradient(110deg,#5c7150,#7f8d61 48%,#566c43);border-top:3px solid #8e9c72;border-radius:1px 1px 4px 4px;color:#f3edcd;font:12px Georgia,serif;display:flex;align-items:center;justify-content:center;transform:rotate(-4deg)}.tier-100 .mini-bag{background:linear-gradient(110deg,#ac915e,#c2ae7d,#a48c58);border-color:#cfc08f;transform:rotate(3deg)}.tier-200 .mini-bag{background:linear-gradient(110deg,#414a45,#5d6359,#384139);border-color:#8a9382;transform:rotate(-3deg)}.tier-label{font-size:9px;color:#7e8f68}.tier-count{font-size:8px;color:#a3ad96;margin-top:2px}
.bottom-row{display:flex;align-items:center;justify-content:space-between;gap:6px;min-height:28px}.health-note{font-size:8px;color:#96a184;line-height:1.7;flex:1;min-width:0}.bottom-row .rest-button{font-size:10px;color:#718b54;background:#edf3e4;padding:0 7px;height:28px;flex:none}.error-toast{position:fixed;bottom:30%;left:20px;right:20px;padding:14px;background:#566844f5;color:#fff;border-radius:10px;font-size:12px;line-height:1.8;z-index:40}.immersive .stage{background:#f7f8f4}
.compact{gap:5px;padding-top:5px}.compact .scene-toolbar{height:29px}.compact .lab{min-height:137px}.compact .lab-heading{height:27px;font-size:11px}.compact .control-card{padding:5px 7px 1px}.compact .control-info{height:23px;font-size:8px}.compact .control-card>button.primary,.compact .control-card>button.light-button{height:32px;font-size:13px}.compact .controls .action-row>button{height:28px;font-size:11px}.compact .control-card>.auto-button{height:23px;font-size:9px}.compact .pack-card{height:47px}.compact .pack-option{height:36px}.compact .mini-bag{height:27px}.compact .bottom-row{min-height:24px}.compact .rest-button{height:24px}.compact .scene-tools{height:26px}.compact .stage-status{top:9px}.compact .stage-status>view{max-width:175px}
.pack-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:5}.opening-bag{position:relative;width:110px;height:150px;border:1px solid #9aaa7b;border-radius:4px 4px 12px 12px;background:#e5edda;color:#708955;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:6px 10px 18px #53603725;animation:bag-in 1.3s both}.opening-bag.tier-100{background:#eee4c6;color:#9b844f}.opening-bag.tier-200{background:#5c6d4d;color:#f0f2e6}.opening-name{font-size:14px;letter-spacing:4px}.opening-price{font:36px Georgia,serif}.opening-caption{font-size:9px}.tear{position:absolute;top:-7px;left:-1px;right:-1px;height:16px;border:1px solid #9aaa7b;background:#dce6c8;animation:tear 1.3s both;transform-origin:right center}.reduced .opening-bag,.reduced .tear{animation:none}.reduced .tear{display:none}@keyframes bag-in{0%{opacity:0;transform:translateY(10px) rotate(-10deg) scale(.8)}20%,75%{opacity:1;transform:rotate(-4deg)}100%{opacity:0;transform:translateY(15px) scale(.8)}}@keyframes tear{0%,25%{transform:none}60%,100%{opacity:0;transform:translate(33px,-45px) rotate(35deg)}}
.breath-overlay{position:fixed;inset:0;z-index:30;padding:30px 24px;background:#f7f9f2;display:flex;flex-direction:column;align-items:center;justify-content:center}.breath-circle{width:200px;height:200px;background:#e8efdc;border:1px solid #c6d6b0;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:30px 0;font-size:20px;color:#68844e}.breath-circle text{font:33px Georgia,serif;margin-top:12px}.breath-overlay .footnote{text-align:center;font-size:11px}.breath-overlay>button{width:auto!important;padding:12px 25px}
