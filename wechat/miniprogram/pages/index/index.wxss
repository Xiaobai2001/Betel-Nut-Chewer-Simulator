.experience{padding:0 30rpx 24rpx}.brand-row{height:76rpx;display:flex;align-items:center;gap:14rpx;margin-bottom:30rpx}.brand-icon{width:64rpx;height:64rpx;border-radius:17rpx}.brand-name{font-size:27rpx;font-weight:600;letter-spacing:2rpx}.brand-sub{font-size:18rpx;color:#8d9c7e;margin-top:3rpx}.intro{padding:12rpx 0 27rpx}.hero-title{font-size:46rpx;margin:9rpx 0;font-weight:600;letter-spacing:2rpx}.scene-toolbar{display:flex;align-items:center;justify-content:space-between;margin:10rpx 0 18rpx}.mini-button{font-size:21rpx;padding:10rpx 16rpx;border:1rpx solid #dce5d0;background:#fafcf7;border-radius:12rpx}.stage{position:relative;overflow:hidden;border-radius:26rpx;border:1rpx solid #e0e6d5;background:#f7f8f4}.scene-canvas{width:100%;height:100%}.stage-metrics{position:absolute;top:20rpx;left:24rpx;pointer-events:none}.stage-metrics .metric-value{font-size:46rpx}.stage-wear{font-size:19rpx;color:#91a17d}.stage-help{position:absolute;bottom:18rpx;left:0;right:0;text-align:center;font-size:19rpx;color:#94a181;pointer-events:none}.scene-tools{display:flex;align-items:center;gap:10rpx;padding:14rpx 0}.scene-tools button{font-size:21rpx;padding:10rpx 22rpx;border:1rpx solid #dee6d3;background:#fff}.scene-tools slider{flex:1;margin:0 12rpx}.controls{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.control-card{background:#fff;border:1rpx solid #e0e7d6;border-radius:22rpx;padding:22rpx 18rpx 10rpx}.control-heading{font-size:20rpx;color:#869973}.control-heading text:last-child{font-size:18rpx}.control-caption{font-size:20rpx;color:#93a184;margin:14rpx 0;min-height:30rpx;line-height:1.5}.wear-track{height:5rpx;border-radius:5rpx;background:#e7eddd;margin-bottom:15rpx;overflow:hidden}.wear-track view{height:100%;background:#91a971}.controls button{font-size:25rpx;padding:16rpx 0;border-radius:13rpx}.controls .action-row{gap:10rpx;margin-top:13rpx}.controls .action-row button{font-size:23rpx}.light-button{background:#fbf6e9;border:1rpx solid #e7dbba;color:#9e8551;marg