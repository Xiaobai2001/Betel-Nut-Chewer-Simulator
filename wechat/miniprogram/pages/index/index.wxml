<view class="experience {{full?'immersive':''}}" style="padding-top:{{safeTop}}px">
  <view class="brand-row"><image src="/assets/icon.png" class="brand-icon"/><view><view class="brand-name">嚼槟榔模拟器</view><view class="brand-sub">把好奇留在屏幕里</view></view></view>
  <view class="intro" wx:if="{{!full}}"><view class="eyebrow">A MOMENT TO PAUSE</view><view class="hero-title">每一口，都看得见。</view><view class="subtitle">体验变化，也练习把下一口留下。</view></view>
  <view class="scene-toolbar"><text class="pill">{{accountLabel}}</text><view class="row"><button class="mini-button" bindtap="toggleSound">音效{{sound?'开':'关'}}</button><button class="mini-button" bindtap="toggleFull">{{full?'退出沉浸':'放大沉浸'}}</button></view></view>
  <view class="stage" style="height:{{sceneHeight}}px">
    <canvas type="2d" id="scene" class="scene-canvas" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"/>
    <view class="stage-metrics"><view><text class="metric-value">{{bites}}</text><text class="metric-unit">口</text></view><view class="stage-wear">形态变化 {{wear}}%</view></view>
    <view class="stage-help">拖槟榔旋转 · 拖香烟移动</view>
    <view wx:if="{{packEffect}}" class="pack-overlay {{reduced?'reduced':''}}"><view class="opening-bag tier-{{packEffect.tier}}"><view class="tear"/><view class="opening-name">{{packEffect.name}}</view><view class="opening-price">{{packEffect.tier}}</view><view class="opening-caption">{{packEffect.capacity}} 颗 · 虚拟包装</view></view></view>
  </view>
  <view class="scene-tools"><button bindtap="reset">复位</button><slider min="65" max="180" value="{{zoom}}" activeColor="#8fa56e" block-color="#789554" block-size="16" bindchanging="zoom" bindchange="zoom"/><button bindtap="clearFloor">清理地面</button></view>
  <view class="controls">
    <view class="control-card"><view class="row between control-heading"><text>01 / 咀嚼</text><text>{{nutPack}} 档</text></view><view class="control-caption">{{status}}</view><view class="wear-track"><view style="width:{{wear}}%"/></view><button id="chew-button" class="primary" disabled="{{hasNut && wear===100}}" bindtap="primary">{{hasNut?'嚼一口':remaining?'取一颗':'换包并取一颗'}}</button><view class="action-row"><button disabled="{{!hasNut || !fibers}}" data-action="spit" bindtap="action">吐渣</button><button disabled="{{!hasNut}}" data-action="discard" bindtap="action">吐出整颗</button></view><button class="auto-button" disabled="{{!hasNut || wear===100}}" bindtap="toggleAuto">{{auto?'停止自动咀嚼':'自动咀嚼'}}</button></view>
    <view class="control-card"><view class="row between control-heading"><text>02 / 烟雾</text><text>{{lit?'燃烧中':used?'已熄灭':'未点燃'}}</text></view><view class="control-caption">本盒余 {{smokeRemaining}} / 20 根 · 已消耗 {{used}}%</view><button id="light-button" class="light-button" disabled="{{lit}}" data-action="light" bindtap="action">{{used && !lit?'再点一根':'点一根'}}</button><view class="action-row"><button disabled="{{!lit || holding}}" data-action="inhale" bindtap="action">吸一口</button><button disabled="{{!holding}}" data-action="exhale" bindtap="action">吐烟</button></view><button class="auto-button extinguish-button" disabled="{{!lit && !holding}}" data-action="extinguish" bindtap="action">熄灭</button></view>
  </view>
  <view class="pack-card"><view class="row between" wx:if="{{!full}}"><text class="section-title">换一包，看看变化。</text><text class="small muted">余 {{remaining}} / {{capacity}} 颗</text></view><view class="pack-options"><button wx:for="{{tiers}}" wx:key="tier" class="pack-option tier-{{item.tier}} {{pack===item.tier?'selected':''}}" data-tier="{{item.tier}}" bindtap="changePack"><text class="tier-number">{{item.tier}}</text><text class="tier-label">{{item.name}} · {{item.capacity}} 颗</text></button></view><view class="caption" wx:if="{{!full}}">均为虚构包装，无购买或消费；换包保留口中这颗。</view></view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button class="rest-button" bindtap="rest">放下，呼吸一分钟 →</button>
  <view class="health-note" bindtap="goGuide">纯模拟 · 槟榔致癌，吸烟有害健康，建议戒除。</view>
</view>
<view class="breath-overlay" wx:if="{{breathing}}"><view class="eyebrow">A MINUTE FOR YOURSELF</view><view class="breath-circle"><view>{{breathPhase}}</view><text>{{breathSeconds}} 秒</text></view><view class="caption">轻松自然地呼吸，不必屏息。</view><button class="quiet space" bindtap="stopBreathing">提前结束</button><view class="footnote">完成 60 秒才计入一次练习；切到后台会暂停并结束本次。</view></view>
