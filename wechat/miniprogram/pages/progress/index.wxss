.package-row{padding:26rpx 0;border-bottom:1rpx solid #eef1e8;font-size:24rpx}.package-shelf{display:flex;gap:13rpx;align-items:center;flex-wrap:wrap;min-height:125rpx}.mini-pack{height:100rpx;width:65rpx;background:#63784e;border-radius:5rpx 5rpx 14rpx 14rpx;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;border-top:7rpx dashed #879a72;font-family:Georgia,serif}.tier-100{background:#aa8d54;border-color:#ccb67e}.tier-200{background:#4d5751;border-color:#7c8981}.mini-label{font-size:16rpx;opacity:.7;font-family:sans-serif}.mini-box{height:90rpx;width:57rpx;border:2rpx solid #cdc3ab;border-top:22rpx solid #a7ad92;border-radius:6rpx;text-align:center;display:flex;flex-direction:column;color:#8e8b78}.dots{display:flex;gap:9rpx;flex-wrap:wrap}.dot{width:18rpx;height:18rpx;border-radius:50%;background:#ebeee5}.dot.filled{background:#809762}.cigarette-dot{width:9rpx;height:26rpx;border-radius:3rpx}.calendar{margin-top:22rpx}.calendar-row{display:flex;justify-content:space-between;padding:13rpx 0;font-size:22rpx;color:#879777;border-bottom:1rpx solid #eff2e9}.achievement{padding:25rpx 0;border-bottom:1rpx solid #edf0e7;color:#96a08e}.unlocked{color:#5e7647}.medal{width:54rpx;height:54rpx;line-height:54rpx;text-align:center;border-radius:50%;background:#f0f4e8;font-size:29rpx;flex-shrink:0}.meter{height:7rpx;background:#edf1e7;border-radius:6rpx;overflow:hidden;margin:18rpx 0 8rpx}.meter view{height:100%;background:#90a96f}.metric-value{margin-top:8rpx}

.web-journal .web-heading{margin-bottom:25px}.web-journal-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:12px 0 14px}.web-journal-tabs{display:flex;padding:4px;gap:3px;background:#eaf0e1;border-radius:10px;min-width:0}.web-journal-tabs button{padding:9px 12px;font-size:11px;line-height:1.4;color:#82936f;background:transparent;border-radius:7px;white-space:nowrap}.web-journal-tabs .selected{background:#fff;color:#536a40;box-shadow:0 2px 6px #52673510}.web-journal-toolbar>.web-sync{font-size:10px;background:#fff;color:#6a8056;border:1px solid #e0e6d8;border-radius:8px;padding:10px;line-height:1.4;white-space:nowrap}.web-sync-note{font-size:10px;color:#95a186;line-height:1.8;margin-bottom:20px}.web-journal-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.web-stat-card{padding:20px 14px;background:#fff;border:1px solid #e5eadf;border-radius:15px;min-width:0}.web-stat-card>text{font-size:10px;color:#89967b}.web-stat-card>.web-stat-value{font:36px Georgia,serif;color:#5e7746;margin:13px 0 10px;overflow-wrap:anywhere}.web-stat-value>text{font:9px sans-serif;color:#9da78f;margin-left:7px}.web-stat-card>view:last-child{font-size:9px;color:#98a48b;line-height:1.7}.web-stat-card.rest-metric{background:#edf3e4}.web-journal-section{margin-top:30px}.web-journal-section-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:12px 0}.web-journal-section-title>text:first-child{font-size:21px;font-weight:600;flex:none}.web-journal-section-title>text:last-child{font-size:10px;color:#929d83;line-height:1.8;text-align:right}.web-journal-section .web-description{font-size:11px;color:#87947c}.web-journal .card{padding:21px;border-radius:13px;margin-top:18px}.web-journal .section-title{font-size:18px;margin-bottom:12px;font-weight:500}.web-journal .caption{font-size:11px}.web-journal .package-row{font-size:11px}.web-journal .pill{font-size:10px}.web-journal .footnote{font-size:9px}.web-journal .two{gap:12px}.web-journal .form-label{font-size:11px}.web-journal .notice{font-size:11px}.web-journal .switch-row text{font-size:12px}.web-journal .package-card{margin-top:14px}
