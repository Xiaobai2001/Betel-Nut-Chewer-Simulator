.web-breathing-card{padding:26px 15px;text-align:center;display:flex;align-items:center;flex-direction:column}.web-breath-orbit{width:270px;height:270px;max-width:100%;display:flex;align-items:center;justify-content:center;margin:25px 0 5px;border:1px solid #ecf0e3;border-radius:50%;background:radial-gradient(circle,#f0f5e9,transparent)}.web-breath-circle{width:210px;height:210px;max-width:80%;border-radius:50%;background:#e1ead5;border:1px solid #d3dfc1;display:flex;align-items:center;justify-content:center;flex-direction:column;box-shadow:0 0 0 17px #edf2e5aa;color:#687d52}.web-breath-circle image{width:34px;height:34px;margin-bottom:16px}.web-breath-circle>view{font-size:18px;font-weight:500}.web-breath-circle>text{font-size:10px;color:#9aaa86;margin-top:10px}.web-breath-circle.running{animation:natural-breath 10s infinite ease-in-out}.web-breath-title{font-size:17px;margin:20px 0 12px;font-weight:500}.web-breath-description{font-size:10px;color:#959e8a;line-height:1.9}.web-breathing-card>button{padding:0 26px;margin-top:25px}.web-breathing-card .web-stop{margin-top:18px;padding:0;background:none;color:#7e9168;font-size:11px}.web-breath-note{font-size:9px;color:#99a18e;line-height:1.8;margin-top:13px}.web-quit-card{padding:23px;margin-top:16px}.web-tip-number{font-size:9px;color:#a5b192;letter-spacing:2px}.web-quit-card .web-breath-title{font-size:18px;margin:15px 0 12px}.web-quit-card .web-description{font-size:11px;color:#8b9680}.web-content>.web-health{margin-top:23px}.reduced .web-breath-circle{animation:none}@keyframes natural-breath{0%,100%{transform:scale(.88)}40%{transform:scale(1)}}
