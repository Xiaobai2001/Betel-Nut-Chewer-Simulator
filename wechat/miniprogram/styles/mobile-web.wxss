/* Mobile sizes, colors, artwork and spacing follow app/styles.css. */
.web-topbar{height:56px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;gap:8px;border-bottom:1px solid #e9ece4;background:#fcfdfa;color:#969d90}
.web-breadcrumb{font-size:10px;white-space:nowrap}.web-breadcrumb text{margin:0 8px;color:#c5c9be}.web-breadcrumb .current{color:#59634f;margin:0}
.web-header-actions{display:flex;gap:9px;align-items:center;min-width:0}.web-topbar button{height:31px;min-width:0;padding:0 9px;border-radius:9px;line-height:1.4;font-size:10px;display:flex;align-items:center;justify-content:center;white-space:nowrap}
.web-topbar .web-account{max-width:112px;overflow:hidden;text-overflow:ellipsis;background:#edf2e5;border:1px solid #dfe6d2;color:#63754e;display:block;line-height:29px}
.web-topbar .web-sound{width:30px!important;flex:none;background:#fff;border:1px solid #e9ece4;padding:6px}.web-icon{width:20px;height:20px;flex:none}.web-sound .web-icon{width:17px;height:17px}
.web-content{padding:25px 16px 20px;max-width:650px;margin:0 auto;color:#29342b;font-size:14px}.web-heading{margin-bottom:21px}.web-eyebrow{font-size:7px;letter-spacing:1.4px;color:#94a083;margin-bottom:11px;line-height:1.3}
.web-title{font-size:25px;line-height:1.3;font-weight:650;letter-spacing:1px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}.web-tag{font-size:8px;letter-spacing:1px;border:1px solid #dce3d3;border-radius:5px;padding:3px 5px;color:#889678;font-weight:400}
.web-subtitle{font-size:10px;color:#90978a;margin-top:11px;line-height:1.8;max-width:290px}.web-card{background:#fff;border:1px solid #e9ece4;border-radius:13px;overflow:hidden;box-shadow:0 3px 6px #3d502d02}
.web-card-heading{display:flex;align-items:center;justify-content:space-between;padding:19px 18px 15px;gap:10px}.web-card-title{font-size:13px;font-weight:600;display:flex;gap:9px;align-items:center}.web-number{font:italic 10px Georgia,serif;color:#a0ab91;font-weight:400}
.web-subtle{font-size:9px;color:#949a8c;background:#f5f6f0;padding:4px 7px;border-radius:5px}.web-description{font-size:10px;color:#a0a697;line-height:1.9}
.web-health{display:flex;align-items:center;gap:10px;padding:13px 12px;margin-bottom:19px;border:1px solid #eae2cf;background:#faf7ee;border-radius:12px}.web-health-icon{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#f0e8d4;flex:none}.web-health-icon image{width:17px;height:17px}.web-health-copy{flex:1;min-width:0;color:#a39474;font-size:9px;line-height:1.8}.web-health-title{font-size:11px;color:#887950;font-weight:600;margin-bottom:5px}.web-health button{font-size:9px;background:none;padding:0;display:flex;align-items:center;gap:4px;flex:none;color:#9d8757}.web-health button image{width:12px;height:12px}
.web-primary,.web-secondary,.web-dark{display:flex;align-items:center;justify-content:center;gap:5px;border-radius:9px;min-height:43px;font-size:11px;line-height:1.4;padding:0 6px;white-space:nowrap}
button.web-primary{background:#4c623c;color:#fff;box-shadow:0 4px 9px #4c623c1a}button.web-dark{background:#58634f;color:white}button.web-secondary{background:#f7f8f3;color:#7a846e;border:1px solid #e9ede1}.web-primary image,.web-secondary image,.web-dark image{width:16px;height:16px}
.web-footer{font-size:8px;color:#adb4a3;display:flex;flex-direction:column;text-align:center;gap:9px;line-height:1.5;margin-top:23px}
.web-rest-link{width:100%!important;display:flex;align-items:center;gap:12px;padding:19px;background:#edf2e5;border:1px solid #e2e9d5;border-radius:13px;margin-top:18px;text-align:left;line-height:1.6}.web-rest-icon{width:35px;height:35px;display:flex;align-items:center;justify-content:center;background:#e0e8d2;border-radius:50%;flex:none}.web-rest-link .web-rest-title{font-size:12px;color:#6b7e54;font-weight:500}.web-rest-link .web-rest-caption{font-size:9px;color:#9aa78a;margin-top:6px}.web-rest-link>.web-icon{margin-left:auto;width:16px;height:16px}
.web-content>button.web-rest-link{width:100%!important;margin-top:18px}
@media(max-width:350px){.web-topbar{padding:0 12px}.web-breadcrumb{font-size:9px}.web-breadcrumb text{margin:0 5px}.web-topbar .web-account{max-width:96px;font-size:9px}.web-header-actions{gap:6px}.web-content{padding-left:12px;padding-right:12px}.web-title{font-size:23px}.web-health{gap:7px}.web-health button{font-size:8px}}
