@import "styles/mobile-web.wxss";
page{background:#f7f8f4;color:#34452e;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.5;overflow-x:hidden}
view,text,button,input,picker,scroll-view{box-sizing:border-box}button{font-size:26rpx;line-height:1.5;margin:0;padding:22rpx 20rpx;border-radius:18rpx;background:#edf2e5;color:#597247;font-weight:500}button::after{border:0}button[disabled]{opacity:.42;color:#829277;background:#edf0e8}button.primary{background:#5c7646;color:white}button.quiet{background:#fff;border:1rpx solid #dce4d2}button.danger{color:#9d614c;background:#f7eee8}.container{padding:32rpx 30rpx 50rpx}.eyebrow{font-size:19rpx;letter-spacing:4rpx;color:#8b9b7a}.title{font-size:46rpx;font-weight:600;letter-spacing:2rpx;margin:12rpx 0}.subtitle,.caption{color:#8a9980;font-size:24rpx;line-height:1.8}.card{background:#fff;border:1rpx solid #e1e7d9;border-radius:26rpx;padding:30rpx;margin-top:26rpx;box-shadow:0 8rpx 30rpx #42522b04}.section-title{font-size:31rpx;font-weight:600;margin-bottom:16rpx}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.muted{color:#91a084}.pill{display:inline-block;padding:7rpx 16rpx;border-radius:24rpx;font-size:21rpx;color:#6f8459;background:#eef3e6}.small{font-size:22rpx}.space{margin-top:20rpx}.error{font-size:24rpx;color:#a26a50;margin-top:18rpx;line-height:1.7}.notice{padding:22rpx 24rpx;border-radius:18rpx;background:#eef3e5;color:#7b8c67;font-size:22rpx;line-height:1.8;margin-top:24rpx}.two{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.form-label{display:block;font-size:24rpx;color:#6f825e;margin:24rpx 0 10rpx}input,.picker{height:86rpx;padding:0 22rpx;border:1rpx solid #dfe6d5;border-radius:14rpx;background:#fafcf6;font-size:27rpx}.picker{display:flex;align-items:center}.footnote{font-size:21rpx;color:#97a38b;line-height:1.8;margin-top:30rpx}.link{color:#607d47;font-size:25rpx}.divider{height:1rpx;background:#e8ecdf;margin:26rpx 0}.switch-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0}.switch-row text{font-size:25rpx}.metric-value{font-size:48rpx;font-family:Georgia,serif;color:#617c47}.metric-unit{font-size:21rpx;color:#93a181;margin-left:6rpx}.metric-label{font-size:23rpx;color:#8a9a79}.badge{font-size:20rpx;color:#8b9c75}.action-row{display:flex;gap:16rpx;margin-top:20rpx}.action-row button{flex:1}.empty{text-align:center;padding:50rpx 24rpx;color:#97a38b}.avatar{width:88rpx;height:88rpx;border-radius:24rpx;flex-shrink:0}

/* Override WeChat style-v2's fixed default button width, including forms/tabs. */
button,button:not([size='mini']){width:auto!important;min-width:0;max-width:100%;box-sizing:border-box;white-space:normal}
.container{width:100%;max-width:100%;overflow-x:hidden}.row,.action-row{min-width:0}.row>view,.action-row>button{min-width:0}.two{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.container>button,.card>button{width:100%!important}.action-row>button{flex:1;width:0!important}
